{
  "name": "coucou-windows",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --import ./tests/setup.mjs --test \"tests/**/*.test.mjs\"",
    "icons": "node scripts/gen-icons.mjs",
    "tauri": "tauri",
    "predev": "cargo build --release -p coucou-hook",
    "prebuild": "cargo build --release -p coucou-hook",
    "pack": "tauri build && node scripts/pack.mjs",
    "pack:update": "tauri build --config src-tauri/tauri.updater.conf.json && node scripts/pack.mjs && node scripts/latest-json.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/prismjs": "^1.26.6",
    "typescript": "^5.6.0",
    "vite": "^6"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "prismjs": "^1.30.0"
  }
}
